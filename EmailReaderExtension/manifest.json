{
  "manifest_version": 3,
  "name": "Email Reader & Chunker",
  "version": "1.0.0",
  "description": "Extract and chunk email information from any webmail service",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://outlook.live.com/*",
    "https://outlook.office.com/*",
    "https://mail.yahoo.com/*",
    "*://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["utils.js", "content-scripts/gmail.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://outlook.live.com/*", "https://outlook.office.com/*"],
      "js": ["utils.js", "content-scripts/outlook.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://mail.yahoo.com/*"],
      "js": ["utils.js", "content-scripts/yahoo.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["utils.js"],
      "matches": ["https://mail.google.com/*", "https://outlook.live.com/*", "https://outlook.office.com/*", "https://mail.yahoo.com/*"]
    }
  ]
}